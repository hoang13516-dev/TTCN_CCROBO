@startuml 05-qt-phan-tich
!include _style.iuml
title QT-03 (TO-BE): Phân tích và ra quyết định

|Người dùng|
start
:Mở dashboard (trang chủ
hoặc link chia sẻ có bộ lọc);
|Hệ thống|
if (Đã đăng nhập?) then (chưa)
  :Chuyển /login?next=<link>;
  |Người dùng|
  :Đăng nhập;
  |Hệ thống|
else (rồi)
endif
if (Vai trò manager?) then (có)
  :Ghi đè bộ lọc chi nhánh
  bằng chi nhánh của user (BR-15);
else (không)
endif
:Đọc bộ lọc trên URL; thiếu thì dùng mặc định
30 ngày tính đến ngày có dữ liệu mới nhất (BR-18);
fork
  :KPI + kỳ trước;
fork again
  :Xu hướng;
fork again
  :Top SP, theo vùng,
  danh mục, kênh;
fork again
  :Đánh giá quy tắc cảnh báo;
end fork
:Hiển thị cảnh báo, 6 KPI, biểu đồ;
|Người dùng|
repeat
  :Đổi bộ lọc, click để lọc chéo,
  drill-down (năm → quý → tháng → ngày,
  vùng → chi nhánh, danh mục → sản phẩm);
  |Hệ thống|
  :Cập nhật URL, tải lại các khối;
  |Người dùng|
repeat while (Đã tìm ra câu trả lời?) is (chưa)
->rồi;
if (Cần báo cáo mang đi họp?) then (có)
  :Xuất Excel hoặc PDF
  theo đúng bộ lọc đang xem;
else (không)
endif
:Ra quyết định (ngoài hệ thống);
stop
@enduml
