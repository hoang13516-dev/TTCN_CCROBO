@startuml 14-seq-nhap-file
!include _style.iuml
title Luồng request: POST /api/imports (nhập file)
autonumber
actor "Nhân viên phân tích" as U
participant "React SPA" as FE
participant "requireAuth +\nrequireRole('analyst')" as AU
participant "Controller" as CT
participant "run-import\n(ETL service)" as SV
participant "Extractor\n(csv / xlsx)" as EX
participant "Transformer" as TR
participant "Loader" as LD
database "PostgreSQL" as DB

U -> FE : bấm "Nhập dữ liệu"
FE -> AU : POST /api/imports {uploadId, sourceId, mapping}
AU -> CT : đủ quyền
CT -> SV : runImport(uploadId, sourceId, mapping, user)
SV -> DB : INSERT import_jobs (running)
SV -> EX : đọc file tạm
loop từng dòng
  EX --> SV : dòng thô
  SV -> TR : map + chuẩn hoá + kiểm tra (BR-07…BR-12)
  TR --> SV : dòng tốt | lỗi (dòng, cột, lý do)
end
SV -> TR : kiểm tra nhất quán theo đơn (BR-07)
alt có ≥ 1 dòng tốt
  SV -> DB : BEGIN (service giữ client của transaction)
  SV -> LD : load(rows, client)
  LD -> DB : upsert dim_product, dim_customer, dim_channel
  LD -> DB : DELETE fact_sales của các đơn trong lô
  LD -> DB : INSERT fact_sales (nhiều dòng / câu)
  alt lỗi khi ghi
    SV -> DB : ROLLBACK
  else thành công
    SV -> DB : COMMIT
  end
end
SV -> DB : INSERT import_errors; UPDATE import_jobs\n(success | partial | failed - BR-13)
SV --> CT : kết quả lần nhập
CT --> FE : 200 {status, total, ok, error, newOrders, updatedOrders}
FE --> U : màn hình kết quả + bảng lỗi
@enduml
