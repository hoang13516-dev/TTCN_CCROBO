@startuml 01-ngu-canh
!include _style.iuml
title Sơ đồ ngữ cảnh hệ thống CN-019
left to right direction

actor "Quản trị viên\n(admin)" as AD
actor "Nhân viên phân tích\n(analyst)" as AN
actor "Quản lý chi nhánh\n(manager)" as MG

rectangle "Hệ thống Dashboard\nphân tích dữ liệu bán hàng\nCN-019" as SYS #dbeafe

file "File CSV / Excel\n(xuất từ POS các chi nhánh)" as FILE
cloud "REST API\nwebsite bán hàng\n(demo: mock-shop-api)" as EXTAPI

AD --> SYS : quản lý người dùng, chi nhánh,\nnguồn dữ liệu, quy tắc cảnh báo
AN --> SYS : tải file, ánh xạ cột,\nđồng bộ API, xem lịch sử nhập
MG --> SYS : xem dashboard, lọc, drill-down,\nxuất báo cáo (chi nhánh mình)

SYS <-- FILE : dòng bán hàng\n(upload)
SYS --> EXTAPI : GET /orders?updated_since&page
SYS ..> MG : KPI, biểu đồ, cảnh báo,\nfile Excel / PDF
@enduml
