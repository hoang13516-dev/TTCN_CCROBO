@startuml 10-uc-tai-khoan
!include _style.iuml
title Phân rã Use Case: Tài khoản & quản trị
left to right direction

actor "Quản lý chi nhánh\n(manager)" as MG
actor "Nhân viên phân tích\n(analyst)" as AN
actor "Quản trị viên\n(admin)" as AD
MG <|-- AN
AN <|-- AD

rectangle "Tài khoản & quản trị" {
  usecase "UC01 Đăng nhập" as UC01
  usecase "UC02 Đăng xuất" as UC02
  usecase "UC03 Đổi mật khẩu" as UC03
  usecase "UC04 Quản lý người dùng" as UC04
  usecase "UC04.1 Xem danh sách" as UC041
  usecase "UC04.2 Thêm người dùng" as UC042
  usecase "UC04.3 Đổi vai trò /\nchi nhánh" as UC043
  usecase "UC04.4 Khoá / mở khoá" as UC044
  usecase "UC04.5 Đặt lại mật khẩu" as UC045
  usecase "UC05 Quản lý chi nhánh" as UC05
  usecase "UC16 Cấu hình quy tắc\ncảnh báo" as UC16
}
MG --> UC01
MG --> UC02
MG --> UC03
AD --> UC04
AD --> UC05
AD --> UC16
UC04 ..> UC041 : <<include>>
UC042 ..> UC04 : <<extend>>
UC043 ..> UC04 : <<extend>>
UC044 ..> UC04 : <<extend>>
UC045 ..> UC04 : <<extend>>

note right of UC043
  Vai trò manager bắt buộc
  gán đúng 1 chi nhánh (BR-15)
end note
note right of UC044
  Không tự khoá / hạ quyền mình;
  không để còn 0 admin hoạt động
end note
@enduml
