@startuml 04-qt-dong-bo
!include _style.iuml
title QT-02 (TO-BE): Khai báo nguồn và đồng bộ từ REST API

|Quản trị viên|
start
:(a) Khai báo nguồn - UC10:
nhập tên, URL, API key;
:Bấm "Kiểm tra kết nối";
|Hệ thống|
:Gọi trang đầu (timeout 10 s);
if (Kết nối được?) then (không)
  :Báo lỗi tiếng Việt
  (sai URL, sai key, hết thời gian);
  stop
else (có)
endif
:Lưu nguồn
(API key không bao giờ trả ra);
stop
|Nhân viên phân tích|
start
:(b) Đồng bộ - UC11:
bấm "Đồng bộ ngay";
|Hệ thống|
if (pg_try_advisory_lock(source_id)?) then (không lấy được)
  :409 "Nguồn đang đồng bộ";
  stop
else (lấy được)
endif
:startedAt = now()
tạo lần nhập (running, trigger = sync);
repeat
  |API nguồn|
  :GET /orders?updated_since=last_synced_at&page=n;
  |Hệ thống|
  if (Lỗi mạng / HTTP?) then (có)
    :Lần nhập failed, giữ nguyên last_synced_at,
    nhả khoá;
    stop
  else (không)
  endif
  :**Transform** các dòng của trang
  (dùng chung QT-01);
repeat while (next_page ≠ null?) is (còn trang)
->hết trang;
:**Load** 1 transaction (dùng chung QT-01);
:last_synced_at = startedAt
nhả khoá, trả kết quả;
stop
@enduml
