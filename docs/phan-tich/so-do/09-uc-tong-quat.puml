@startuml 09-uc-tong-quat
!include _style.iuml
title Sơ đồ Use Case tổng quát - CN-019
left to right direction
skinparam packageStyle rectangle

actor "Quản lý chi nhánh\n(manager)" as MG
actor "Nhân viên phân tích\n(analyst)" as AN
actor "Quản trị viên\n(admin)" as AD
actor "Hệ thống nguồn API" as EXT <<hệ thống>>

rectangle "Hệ thống Dashboard phân tích dữ liệu bán hàng CN-019" {
  package "Tài khoản & phân tích" {
    usecase "UC01 Đăng nhập" as UC01
    usecase "UC02 Đăng xuất" as UC02
    usecase "UC03 Đổi mật khẩu" as UC03
    usecase "UC12 Xem dashboard KPI" as UC12
    usecase "UC13 Lọc đa chiều\n& lọc chéo" as UC13
    usecase "UC14 Drill-down" as UC14
    usecase "UC15 Xem cảnh báo\nchỉ số bất thường" as UC15
    usecase "UC17 Xuất báo cáo\nExcel / PDF" as UC17
  }
  package "Quản lý dữ liệu (ETL)" {
    usecase "UC06 Nhập dữ liệu\ntừ file" as UC06
    usecase "UC07 Ánh xạ cột" as UC07
    usecase "UC08 Tải file mẫu" as UC08
    usecase "UC09 Xem lịch sử\n& lỗi nhập" as UC09
    usecase "UC11 Đồng bộ dữ liệu\ntừ API" as UC11
  }
  package "Quản trị" {
    usecase "UC04 Quản lý người dùng" as UC04
    usecase "UC05 Quản lý chi nhánh" as UC05
    usecase "UC10 Quản lý nguồn\ndữ liệu" as UC10
    usecase "UC16 Cấu hình quy tắc\ncảnh báo" as UC16
  }
}

MG --> UC01
MG --> UC02
MG --> UC03
MG --> UC12
UC12 .[norank].> UC15 : <<include>>
UC13 .[norank].> UC12 : <<extend>>
UC14 .[norank].> UC12 : <<extend>>
UC17 .[norank].> UC12 : <<extend>>

AN --> UC06
AN --> UC09
AN --> UC11
UC06 .[norank].> UC07 : <<include>>
UC08 .[norank].> UC06 : <<extend>>

AD --> UC04
AD --> UC05
AD --> UC10
AD --> UC16

UC10 --> EXT
UC11 --> EXT

MG -[hidden]- AN
AN -[hidden]- AD

legend bottom
  Phân cấp tác nhân (sơ đồ 09b): Quản trị viên ⊃ Nhân viên phân tích ⊃ Quản lý chi nhánh
  → tác nhân con thực hiện được MỌI use case của tác nhân cha.
  Phạm vi dữ liệu KHÔNG kế thừa: manager chỉ thấy chi nhánh của mình (BR-15).
endlegend
@enduml
