@startuml 06-star-schema
!include _style.iuml
title Kho dữ liệu hình sao - grain: 1 sản phẩm trong 1 đơn
hide circle
hide methods
skinparam linetype ortho
skinparam ClassBackgroundColor #eff6ff
skinparam ClassBorderColor #2563eb

entity "fact_sales" as F #fef9c3 {
  * sales_key : BIGSERIAL <<PK>>
  --
  * source_id : INT <<FK data_sources>>
  * order_code : TEXT  (chiều suy biến)
  * line_no : SMALLINT
  * date_key : INT <<FK>>
  * ordered_at : TIMESTAMPTZ
  * branch_key : INT <<FK>>
  * channel_key : INT <<FK>>
  * product_key : INT <<FK>>
    customer_key : INT <<FK>> (NULL = khách lẻ)
  * status : completed | cancelled | returned
  --
  * quantity : INT
  * unit_price : BIGINT
  * discount : BIGINT
  * cost_price : BIGINT
    revenue = quantity × unit_price − discount
    cost_amount = quantity × cost_price
  --
  * import_job_id : INT <<FK import_jobs>>
  UNIQUE (source_id, order_code, line_no)
}

entity "dim_date" as D {
  * date_key : INT <<PK>> (yyyymmdd)
  --
  full_date, day, month, quarter, year,
  iso_week, day_of_week, is_weekend
}
entity "dim_branch" as B {
  * branch_key : SERIAL <<PK>>
  --
  code UNIQUE, name, province,
  region : north | central | south,
  is_active
}
entity "dim_product" as P {
  * product_key : SERIAL <<PK>>
  --
  sku UNIQUE, name, category
}
entity "dim_customer" as C {
  * customer_key : SERIAL <<PK>>
  --
  customer_code UNIQUE, name
}
entity "dim_channel" as CH {
  * channel_key : SERIAL <<PK>>
  --
  code UNIQUE, name
}

D ||--o{ F
B ||--o{ F
P ||--o{ F
C |o--o{ F
CH ||--o{ F
@enduml
