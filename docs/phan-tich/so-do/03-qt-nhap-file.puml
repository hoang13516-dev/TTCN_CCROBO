@startuml 03-qt-nhap-file
!include _style.iuml
title QT-01 (TO-BE): Nhập dữ liệu bán hàng từ file CSV/Excel

|Nhân viên phân tích|
start
:Chuẩn bị file (xuất từ POS
hoặc điền file mẫu — UC08);
:Chọn nguồn + chọn file;
|Hệ thống|
:Kiểm tra đuôi, ≤ 5 MB,
≤ 10.000 dòng, ≤ 30 cột (BR-14);
if (Hợp lệ?) then (không)
  :Báo lỗi 400 kèm lý do;
  stop
else (có)
endif
:**Extract:** đọc tên cột + 10 dòng đầu;
:Gợi ý ánh xạ theo từ điển đồng nghĩa;
|Nhân viên phân tích|
repeat
  :Xác nhận / sửa ánh xạ;
  :Xem 10 dòng sau chuẩn hoá;
|Hệ thống|
repeat while (Đủ trường bắt buộc?) is (thiếu → nêu tên trường)
->đủ;
|Nhân viên phân tích|
:Bấm "Nhập dữ liệu";
|Hệ thống|
:Tạo lần nhập (running);
repeat
  :**Transform:** 1 dòng → áp ánh xạ
  → chuẩn hoá ngày / số / trạng thái / kênh
  → kiểm tra (Zod, chi nhánh có sẵn);
  if (Dòng hợp lệ?) then (có)
    :Thêm vào danh sách dòng tốt;
  else (không)
    :Thêm lỗi (số dòng, cột, lý do);
  endif
repeat while (Còn dòng?) is (có)
->hết file;
:Kiểm tra nhất quán theo đơn (BR-07):
đơn mâu thuẫn → mọi dòng của đơn sang lỗi;
if (Có ≥ 1 dòng tốt?) then (có)
  :**Load** — BEGIN
  upsert dim_product, dim_customer, dim_channel
  DELETE fact_sales của các đơn trong lô
  INSERT fact_sales;
  if (Lỗi khi ghi?) then (có)
    :ROLLBACK → failed;
  else (không)
    :COMMIT → success / partial;
  endif
else (không)
  :failed (không ghi gì vào kho);
endif
:Hiển thị: tổng, hợp lệ, lỗi,
đơn mới, đơn cập nhật + bảng lỗi;
|Nhân viên phân tích|
if (Có dòng lỗi?) then (có)
  :Tải CSV dòng lỗi, sửa file gốc,
  nhập lại cả file (an toàn nhờ BR-06);
else (không)
endif
stop
@enduml
