@startuml 03-qt-nhap-file
!include _style.iuml
title QT-01 (TO-BE): Nhập dữ liệu bán hàng từ file CSV/Excel

|Nhân viên phân tích|
start
:Xuất file đơn hàng từ nguồn
(POS / sàn TMĐT) — ngoài hệ thống;
:Mở trang "Nhập dữ liệu", chọn file;
|Hệ thống|
:Kiểm tra đuôi file (.csv/.xlsx)
và dung lượng (≤ 10 MB);
if (Hợp lệ?) then (không)
  :Báo lỗi 400/413
  "Chỉ nhận .csv/.xlsx ≤ 10 MB";
  stop
else (có)
endif
:Đọc tên cột + 20 dòng đầu (preview);
:Gợi ý ánh xạ cột
(ưu tiên mẫu ánh xạ đã lưu, sau đó đoán theo tên cột);
|Nhân viên phân tích|
repeat
  :Xác nhận / sửa ánh xạ cột;
  :Chọn định dạng ngày (dd/MM/yyyy...);
  :Đặt giá trị cố định nếu file thiếu cột
  (vd: kênh = "shopee");
|Hệ thống|
repeat while (Đủ các trường bắt buộc?) is (thiếu → báo tên trường)
->đủ;
|Nhân viên phân tích|
:Bấm "Nhập dữ liệu"
(tuỳ chọn: lưu mẫu ánh xạ);
|Hệ thống|
:Tạo import_job (pending → running),
trả 202 + jobId;
note right: FE hỏi trạng thái mỗi 1 giây
repeat
  :Đọc 1 dòng (stream) → áp ánh xạ
  → chuẩn hoá ngày/số/trạng thái → validate (Zod);
  if (Dòng hợp lệ?) then (có)
    :Ghi staging_rows;
  else (không)
    :Ghi import_errors
    (số dòng, cột, lý do, dữ liệu gốc);
  endif
repeat while (Còn dòng?) is (có)
->hết file;
:Kiểm tra nhất quán theo đơn (BR-07):
các dòng cùng mã đơn mâu thuẫn → chuyển cả đơn sang lỗi;
if (Có ≥ 1 dòng hợp lệ?) then (có)
  :BEGIN TRANSACTION
  upsert categories → products → customers
  → channels → orders → order_items;
  if (Lỗi khi ghi?) then (có)
    :ROLLBACK
    job = failed;
  else (không)
    :COMMIT;
    :REFRESH MATERIALIZED VIEW
    CONCURRENTLY mv_daily_sales;
    :job = success (0 lỗi)
    hoặc partial (có lỗi);
  endif
else (không)
  :job = failed nếu có dòng lỗi,
  success nếu mọi dòng bị bỏ qua (BR-15);
endif
:Hiển thị kết quả: tổng / OK / lỗi / bỏ qua;
|Nhân viên phân tích|
if (Có dòng lỗi?) then (có)
  :Tải danh sách dòng lỗi (CSV);
  :Sửa trong file gốc rồi nhập lại
  (an toàn: nhập lại không nhân đôi doanh thu);
else (không)
endif
stop
@enduml
